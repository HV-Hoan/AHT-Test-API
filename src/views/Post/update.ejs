<form action="/api/post/update/<%= post._id %>" method="POST" enctype="multipart/form-data">
    <table>
        <tr>
            <th><label for="image">Image</label></th>
            <td>
                <input type="file" id="image" name="image" accept="image/*" />
                <%= post.image %>
            </td>
        </tr>
        <tr>
            <th><label for="title">Title</label></th>
            <td><input type="text" id="title" name="title" value="<%= post.title %>" required /></td>
        </tr>
        <tr>
            <th><label for="content">Content</label></th>
            <td><textarea id="content" name="content" required><%= post.content %></textarea></td>
        </tr>
        <tr>
            <th><label for="status">Status</label></th>
            <td><input type="text" id="status" name="status" value="<%= post.status %>" required /></td>
        </tr>
        <tr>
            <td colspan="2">
                <button type="submit" class="btn">Update Post</button>
                <a href="/api/post/list" class="btn">Back to List</a>
            </td>
        </tr>
    </table>
</form>
<style>
    table {
        width: 50%;
        border-collapse: collapse;
    }

    td {
        padding: 10px;
        text-align: left;
    }

    th {
        background-color: #f2f2f2;
    }

    input[type="text"],
    textarea {
        font-size: 18px;
        padding: 10px;
        width: 100%;
        border-radius: 5px;
        border: 1px solid #ccc;
        box-sizing: border-box;
    }

    textarea {
        height: 100px;
    }


    .btn {
        display: inline-block;
        padding: 10px 20px;
        background-color: #2ba8ca;
        color: #ffffff;
        border: none;
        border-radius: 5px;
        text-decoration: none;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }
</style>