<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <title>Đăng nhập </title>
</head>

<body>
    <div class="row ">
        <div class="w-100 h-100 bg-white p-5 card ">
            <div class="text-center fs-5 fw-bold ">
                <h2 style="color: rgb(255, 157, 0);">Đăng nhập</h2>
            </div>
            <div class="mb-3">
                <label class="form-label">username</label>
                <input type="text" class="form-control" id="username" placeholder="Username">
            </div>
            <div class="mb-3 d-grid ">
                <label class="form-label">Password</label>
                <input type="text" class="form-control" id="password">
            </div>
            <div class="mb-3 d-flex justify-content-center">
                <button class="btn btn-warning osition-relative " id="btnDangNhap" style="color: white;">Đăng
                    nhập</button>
            </div>
        </div>
    </div>
    <script>
        const btnDangNhap = document.querySelector("#btnDangNhap");
        btnDangNhap.addEventListener("click", login);

        async function login() {
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;

            if (!username || !password) {
                alert("Username hoặc Password không đúng");
                return;
            }

            try {
                const response = await fetch('http://localhost:3030/api/acc', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ username, password })
                });

                if (response.ok) {
                    const data = await response.json();
                    localStorage.setItem('token', data.token);

                    alert('Login successful');
                    window.location.href = 'http://localhost:3030/api/post/list';
                } else {
                    const errorMsg = await response.text();
                    alert('Login failed: ' + errorMsg);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred during login. Please try again.');
            }
        }

        async function fetchData(link) {
            const token = localStorage.getItem('token');
            if (!token) {
                alert('No token found, please log in first.');
                return;
            }
            try {
                const response = await fetch(link, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                if (response.ok) {
                    const htmlContent = await response.text();
                    document.querySelector("body").innerHTML = htmlContent;
                } else {
                    alert('Failed to fetch data');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while fetching data.');
            }
        }
    </script>
</body>

</html>