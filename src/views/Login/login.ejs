<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <title>Document</title>
</head>

<body>
    <div class="row ">
        <div class="w-100 h-100 bg-white p-5 card ">
            <div class="text-center fs-5 fw-bold ">
                <h2 style="color: rgb(255, 157, 0);">Đăng nhập</h2>
            </div>
            <div class="mb-3">
                <label class="form-label">username</label>
                <input type="text" class="form-control" id="username" placeholder="Username">
            </div>
            <div class="mb-3 d-grid ">
                <label class="form-label">Password</label>
                <input type="text" class="form-control" id="password">
            </div>
            <div class="mb-3 d-flex justify-content-center">
                <button class="btn btn-warning osition-relative " id="btnDangNhap" style="color: white;">Đăng
                    nhập</button>
            </div>
        </div>
    </div>

    <script>
        document.getElementById("btnDangNhap").addEventListener("click", function () {
            const username = document.getElementById("username").value;
            const password = document.getElementById("password").value;

            console.log("Username:", username);
            console.log("Password:", password);

            // Gửi yêu cầu đăng nhập đến máy chủ
            fetch('http://localhost:3030/api/acc', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ username, password })
            })
                .then(response => response.json())
                .then(data => {
                    console.log("Login Response Data:", data);
                    if (data.datas.accessToken) {
                        localStorage.setItem('token', data.datas.accessToken);
                        console.log("Token lưu trữ:", data.datas.accessToken);

                        fetch('http://localhost:3030/api/acc/verify', {
                            method: 'POST',
                            headers: {
                                'Authorization': `Bearer ${localStorage.getItem('token')}`,  // Đảm bảo 'Bearer' có trước toke
                                'Content-Type': 'application/json'
                            }
                        })
                            .then(response => response.json())
                            .then(verifyData => {
                                console.log("Verification Response Data:", verifyData);
                                if (verifyData.success) {

                                    window.location.href = 'http://localhost:3030/api/post/list';
                                } else {
                                    alert(verifyData.message || "Bạn không có quyền");
                                }
                            })
                            .catch(error => console.error('Lỗi xác minh:', error));
                    } else {
                        alert("Đăng nhập thất bại");
                    }
                })
                .catch(error => console.error('Lỗi đăng nhập:', error));
        });
    </script>
</body>

</html>